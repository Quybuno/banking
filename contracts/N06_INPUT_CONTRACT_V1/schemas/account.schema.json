{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "account.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string",
      "enum": [
        "VND",
        "USD"
      ]
    },
    "opening_balance_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9000000000000000
    },
    "opening_business_date": {
      "type": "string",
      "format": "date"
    },
    "account_type": {
      "const": "CUSTOMER_DEPOSIT"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "account_id",
    "currency",
    "opening_balance_minor",
    "opening_business_date",
    "account_type"
  ]
}
