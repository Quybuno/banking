# File mẫu biến môi trường cho N06 (chỉ chứa tên biến và placeholder vô hại, không có secret thật).
# Sao chép thành .env (hoặc chạy `n06 init-local` sau T03) để sử dụng cục bộ.

# Profile mặc định (default | demo | benchmark | test)
N06_PROFILE=demo

# Object store (MinIO / S3A) credentials — bắt buộc từ biến môi trường
N06_OBJECT_STORE_ACCESS_KEY=CHANGE_ME_OBJECT_STORE_ACCESS_KEY
N06_OBJECT_STORE_SECRET_KEY=CHANGE_ME_OBJECT_STORE_SECRET_KEY

# PostgreSQL passwords (tách riêng 4 database/user: mart, control, airflow, metabase)
N06_POSTGRES_MART_PASSWORD=CHANGE_ME_MART_DB_PASSWORD
N06_POSTGRES_CONTROL_PASSWORD=CHANGE_ME_CONTROL_DB_PASSWORD
N06_POSTGRES_AIRFLOW_PASSWORD=CHANGE_ME_AIRFLOW_DB_PASSWORD
N06_POSTGRES_METABASE_PASSWORD=CHANGE_ME_METABASE_DB_PASSWORD

# Ví dụ ghi đè cấu hình qua biến môi trường (cú pháp N06__<SECTION>__<KEY>):
# N06__PRODUCER__KEY_STRATEGY=transaction_id
# N06__PRODUCER__RATE=5000
# N06__SPARK__SHUFFLE_PARTITIONS=50
# N06__DATASET__TRANSACTION_COUNT=10000

# Cấu hình hạ tầng Docker Compose (TASK T02) — khớp config/default.toml và config/test.toml
N06_POSTGRES_SUPERUSER=n06_admin
N06_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD
N06_POSTGRES_BOOTSTRAP_DB=postgres

N06_POSTGRES_MART_DB=n06_mart
N06_POSTGRES_MART_USER=n06_mart_user

N06_POSTGRES_CONTROL_DB=n06_control
N06_POSTGRES_CONTROL_USER=n06_control_user

N06_POSTGRES_AIRFLOW_DB=n06_airflow
N06_POSTGRES_AIRFLOW_USER=n06_airflow_user

N06_POSTGRES_METABASE_DB=n06_metabase
N06_POSTGRES_METABASE_USER=n06_metabase_user

# Host port mapping cho môi trường local / integration test (khớp config/test.toml)
N06_KAFKA_HOST_PORT=19092
N06_MINIO_API_HOST_PORT=19000
N06_MINIO_CONSOLE_HOST_PORT=19001
N06_POSTGRES_HOST_PORT=15432
N06_SPARK_UI_HOST_PORT=18080
N06_METABASE_HOST_PORT=13000
N06_METABASE_HEAP=1g

# Mật khẩu role chỉ đọc n06_mart_ro (ADR-0013; đặt bằng ALTER ROLE sau khi chạy migration mart)
N06_POSTGRES_MART_RO_PASSWORD=CHANGE_ME_MART_RO_PASSWORD
